# Copy this package under challenges/AD and rename this file to challenge.yaml.
name: 'BYOC A&D SSH rehearsal'
author: 'Your team'
description: |
  Run the team setup on your Docker host and edit the banner from your host shell.
type: AttackDefense
category: Web
disableBloodBonus: true
container:
  memoryLimit: 64
  cpuCount: 1
  exposePort: 8080
ad:
  allowEgress: false
  selfHosted: true
