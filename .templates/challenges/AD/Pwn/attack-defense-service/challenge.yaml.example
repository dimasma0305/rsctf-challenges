# Copy into a new package under challenges/ as challenge.yaml.
name: 'Hosted A&D challenge'
author: 'Your team'
description: |
  Add the player-facing instructions here.
type: AttackDefense
category: Pwn

# Add src/Dockerfile and checker/run.py.
disableBloodBonus: true
container:
  memoryLimit: 64
  cpuCount: 1
  exposePort: 8080
  enableTrafficCapture: false
ad:
  allowEgress: true
  allowSelfReset: true
  selfHosted: false
